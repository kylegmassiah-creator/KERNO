     all the text stays legible while the photo still shows through. */
  .hero-backdrop::after {
    background:
      linear-gradient(180deg,
        rgba(0, 0, 0, 0.58) 0%,
        rgba(0, 0, 0, 0.50) 55%,
        rgba(0, 0, 0, 0.60) 100%);
